{
  "hosting": {
    "source": "apps/web",
    "target": "app",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.DS_Store",
      "dev-only"
    ],
    "predeploy": [
      "npm --prefix apps/web run build"
    ],
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "512MiB",
      "concurrency": 80,
      "cpu": 1
    },
    "headers": [
      {
        "source": "**/*.@(css|js|jpg|jpeg|png|svg|gif|webp|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}